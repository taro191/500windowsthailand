# Copy to .env (never commit .env). All values are optional except APP_SECRET in production.

PORT=3001
NODE_ENV=development

# Long random string (64+ chars). Used to sign sessions, hash and encrypt citizen IDs.
# Changing it makes stored citizen IDs unreadable, so keep it safe and never change it in production.
APP_SECRET=change-me-to-a-long-random-string

# Database: sqlite (development) or mysql (production on Plesk).
DB_CLIENT=sqlite
SQLITE_FILE=./data/dev.sqlite
# DATABASE_URL=mysql://user:password@localhost:3306/windows500

# Where uploaded images (window images, slips) are stored, and the built web app to serve.
UPLOAD_DIR=./data/uploads
PUBLIC_DIR=../web/dist

# First admin account, created on start if no admin exists. Change the password after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Super admin: the admin account with this email can also create users and grant or remove
# admin rights (defaults to ADMIN_EMAIL). The account must already be an admin.
SUPER_ADMIN_EMAIL=

# Card payments: "simulated" (until a payment gateway is chosen) or "disabled".
CARD_PAYMENTS=simulated
# OTP for KYC: "dev" shows the code on screen, "sms" sends it by SMS through THSMS (thsms.com).
OTP_MODE=dev
# For OTP_MODE=sms: Access Token from thsms.com › API Key, and a sender name approved in that
# account (defaults to NOTICE). Each OTP uses one SMS credit. A token longer than a host's
# env limit (Plesk: 255) can be split in order over THSMS_TOKEN, THSMS_TOKEN_2 and THSMS_TOKEN_3.
THSMS_TOKEN=
THSMS_SENDER=
# Demo helpers: sample slip button, skip 24h edit wait, back-date ownership, demo accounts.
DEMO_TOOLS=false
